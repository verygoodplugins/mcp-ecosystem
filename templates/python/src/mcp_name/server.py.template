#!/usr/bin/env python3
"""MCP server for {description}."""

import asyncio
import os
from typing import Any

from dotenv import load_dotenv
from mcp.server import Server
from mcp.server.stdio import stdio_server
from mcp.types import TextContent, Tool, ToolAnnotations

load_dotenv()



def require_api_key() -> str:
    """Read the credential lazily so tools/list works without configuration."""
    api_key = os.getenv("{NAME_UPPER}_API_KEY")
    if not api_key:
        raise ValueError("Missing required {NAME_UPPER}_API_KEY environment variable")
    return api_key


server = Server("mcp-{name}")


@server.list_tools()
async def list_tools() -> list[Tool]:
    """List available tools."""
    return [
        Tool(
            name="example_tool",
            description="Example tool - replace with your actual tools",
            annotations=ToolAnnotations(
                title="Example tool",
                readOnlyHint=True,
                destructiveHint=False,
            ),
            inputSchema={
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "The query to process",
                    },
                },
                "required": ["query"],
            },
        ),
    ]


@server.call_tool()
async def call_tool(tool_name: str, arguments: dict[str, Any]) -> list[TextContent]:
    """Handle tool calls."""
    try:
        match tool_name:
            case "example_tool":
                require_api_key()
                query = arguments.get("query", "")
                # TODO: Implement your tool logic here
                return [TextContent(type="text", text=f"Processed query: {query}")]

            case _:
                raise ValueError(f"Unknown tool: {tool_name}")

    except ValueError as e:
        # Expected configuration/input errors carry safe, credential-free text.
        return [TextContent(type="text", text=f"Error: {e}")]
    except Exception:
        # Never echo upstream bodies, paths, or stack traces to the client.
        return [TextContent(type="text", text="Error: request failed")]


async def run_server():
    """Run the MCP server."""
    async with stdio_server() as (read_stream, write_stream):
        await server.run(read_stream, write_stream, server.create_initialization_options())


def main():
    """Entry point."""
    asyncio.run(run_server())


if __name__ == "__main__":
    main()
