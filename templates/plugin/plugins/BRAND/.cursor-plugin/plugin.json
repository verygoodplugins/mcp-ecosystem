{
  "name": "{brand}",
  "displayName": "{Brand}",
  "version": "{version}",
  "description": "{description} Unofficial; not affiliated with {Brand}.",
  "author": {
    "name": "Very Good Plugins",
    "email": "info@verygoodplugins.com",
    "url": "https://github.com/verygoodplugins"
  },
  "homepage": "https://github.com/verygoodplugins/mcp-{name}",
  "repository": "https://github.com/verygoodplugins/mcp-{name}",
  "license": "MIT",
  "keywords": ["{brand}", "mcp"],
  "logo": "assets/icon.svg",
  "variables": {
    "type": "object",
    "properties": {
      "{SERVICE}_MCP_URL": {
        "type": "string",
        "title": "{Brand} MCP URL",
        "description": "Streamable HTTP endpoint ending in /mcp.",
        "minLength": 1
      },
      "{SERVICE}_HTTP_CALLER_KEY": {
        "type": "string",
        "title": "{Brand} caller key",
        "description": "Bearer key issued to this client. Set in Plugins → Configure; never commit it.",
        "minLength": 1
      }
    },
    "required": ["{SERVICE}_MCP_URL", "{SERVICE}_HTTP_CALLER_KEY"]
  },
  "mcpServers": {
    "{brand}": {
      "url": "${{SERVICE}_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${{SERVICE}_HTTP_CALLER_KEY}",
        "Accept": "application/json, text/event-stream"
      },
      "enabledTools": ["{name}_example_tool"]
    }
  }
}
